syntax = "v1"

type (
	RecommendItem {
		Id        string            `json:"id"`
		ArticleId string            `json:"article_id"`
		Score     float64           `json:"score"`
		Source    string            `json:"source"`
		Rank      int               `json:"rank"`
		Reason    string            `json:"reason,optional"`
		Features  map[string]string `json:"features,optional"`
		ExtInfo   map[string]string `json:"ext_info,optional"`
	}
	RecommendReq {
		TenantId  string            `json:"tenant_id"`
		RequestId string            `json:"request_id"`
		Scenario  string            `json:"scenario"`
		Channel   string            `json:"channel,optional"`
		UserId    string            `json:"user_id,optional"`
		Query     string            `json:"query,optional"`
		TopK      int32             `json:"top_k,optional"`
		PathMode  string            `json:"path_mode,optional"`
		Debug     bool              `json:"debug,optional"`
		ExtInfo   map[string]string `json:"ext_info,optional"`
	}
	RecommendResp {
		RequestId string            `json:"request_id"`
		TraceId   string            `json:"trace_id"`
		PathTaken string            `json:"path_taken"`
		Items     []RecommendItem   `json:"items"`
		ErrMsg    string            `json:"err_msg,optional"`
		ExtInfo   map[string]string `json:"ext_info,optional"`
	}
	EventBatchReq {
		Events []map[string]string `json:"events"`
	}
	EventBatchResp {
		Accepted int32  `json:"accepted"`
		ErrMsg   string `json:"err_msg,optional"`
	}
)

@server (
	prefix: /api/v2
	group:  recommend
)
service recommend-api {
	@handler Recommend
	post /recommend (RecommendReq) returns (RecommendResp)

	@handler RecommendStream
	post /recommend/stream (RecommendReq)

	@handler Events
	post /events (EventBatchReq) returns (EventBatchResp)

	@handler SkillList
	get /admin/skills
}

@server (
	prefix: /api/v1/admin
	group:  recommend-admin
)
service recommend-api {
	@handler EvaluationSummary
	get /reco/evaluation/summary
}

