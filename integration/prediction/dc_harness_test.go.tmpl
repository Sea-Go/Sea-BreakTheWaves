	"encoding/json"
	"log/slog"
	"net/http/httptest"
	"os"
	"path/filepath"
	"strings"
	"testing"
	"time"

	"cloud-personal-data-center/internal/auth"
	"cloud-personal-data-center/internal/config"
	"cloud-personal-data-center/internal/nativeauth"
	predictionservice "cloud-personal-data-center/internal/prediction"
	"cloud-personal-data-center/internal/store"
	"cloud-personal-data-center/internal/telemetry"
