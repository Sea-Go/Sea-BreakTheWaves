)

type externalPredictionHarnessRuntime struct {
	Endpoint      string `json:"endpoint"`
	PostgresDSN   string `json:"postgres_dsn"`
	AdminEmail    string `json:"admin_email"`
	AdminPassword string `json:"admin_password"`
	UserAEmail    string `json:"user_a_email"`
	UserAPassword string `json:"user_a_password"`
	UserBEmail    string `json:"user_b_email"`
	UserBPassword string `json:"user_b_password"`
	MetricsToken  string `json:"metrics_token"`
	DCCommit      string `json:"dc_commit"`
}

func TestBTWPredictionExternalHarness(t *testing.T) {
	runtimePath, donePath := os.Getenv("PREDICTION_HARNESS_RUNTIME"), os.Getenv("PREDICTION_HARNESS_DONE")
	if runtimePath == "" || donePath == "" {
		t.Skip("external BTW prediction harness paths are required")
	}
	pool := predictionHTTPDatabase(t)
	logging, err := telemetry.NewLogging(os.Stdout, telemetry.LogIdentity{Service: "sea-datacenter-prediction-harness",
		Environment: "test", Version: os.Getenv("PREDICTION_HARNESS_DC_COMMIT"), InstanceID: "btw-cross-repo"}, slog.LevelInfo)
	if err != nil {
		t.Fatal(err)
	}
	logger, err := logging.Logger("prediction", "application")
	if err != nil {
		t.Fatal(err)
	}
	registry, err := predictionservice.NewRegistry(pool, logger)
	if err != nil {
		t.Fatal(err)
	}
	users := store.NewUserStore(pool)
	password := "Prediction-" + uuid.NewString() + "-Aa1!"
	hash, err := bcrypt.GenerateFromPassword([]byte(password), bcrypt.MinCost)
	if err != nil {
		t.Fatal(err)
	}
	suffix := strings.ReplaceAll(uuid.NewString(), "-", "")
	admin, err := users.Create(context.Background(), "prediction-admin-"+suffix+"@example.test", string(hash), "Prediction Admin", "admin", "active")
	if err != nil {
		t.Fatal(err)
	}
	userA, err := users.Create(context.Background(), "prediction-a-"+suffix+"@example.test", string(hash), "Prediction A", "user", "active")
	if err != nil {
		t.Fatal(err)
	}
	userB, err := users.Create(context.Background(), "prediction-b-"+suffix+"@example.test", string(hash), "Prediction B", "user", "active")
	if err != nil {
		t.Fatal(err)
	}
	redisServer := miniredis.RunT(t)
	redisClient := redis.NewClient(&redis.Options{Addr: redisServer.Addr()})
	t.Cleanup(func() { _ = redisClient.Close() })
	sessions := nativeauth.New(redisClient, 15*time.Minute, 24*time.Hour, nativeauth.WithAuthEpochVerifier(users))
	metricsToken := strings.Repeat("m", 32)
	cfg := config.Config{JWTSecret: []byte(strings.Repeat("j", 32)), NativeAccessTTL: 15 * time.Minute,
		NativeRefreshTTL: 24 * time.Hour, Observability: config.ObservabilityConfig{MetricsScrapeToken: metricsToken}}
	metrics := telemetry.NewMetrics()
	handler := (&API{users: users, auth: auth.NewService(cfg), nativeSessions: sessions,
		prediction: registry, metrics: metrics, logger: logger, cfg: cfg}).Router()
	server := httptest.NewServer(telemetry.HTTPHandler(handler))
	t.Cleanup(server.Close)
	runtime := externalPredictionHarnessRuntime{Endpoint: server.URL, PostgresDSN: pool.Config().ConnString(),
		AdminEmail: admin.Email, AdminPassword: password, UserAEmail: userA.Email, UserAPassword: password,
		UserBEmail: userB.Email, UserBPassword: password, MetricsToken: metricsToken,
		DCCommit: os.Getenv("PREDICTION_HARNESS_DC_COMMIT")}
	body, err := json.Marshal(runtime)
	if err != nil {
		t.Fatal(err)
	}
	if err := os.MkdirAll(filepath.Dir(runtimePath), 0700); err != nil {
		t.Fatal(err)
	}
	temporary := runtimePath + ".tmp"
	if err := os.WriteFile(temporary, append(body, '\n'), 0600); err != nil {
		t.Fatal(err)
	}
	if err := os.Rename(temporary, runtimePath); err != nil {
		t.Fatal(err)
	}
	deadline := time.NewTimer(3 * time.Minute)
	defer deadline.Stop()
	ticker := time.NewTicker(20 * time.Millisecond)
	defer ticker.Stop()
	for {
		select {
		case <-deadline.C:
			t.Fatal("BTW prediction acceptance did not signal completion")
		case <-ticker.C:
			if _, err := os.Stat(donePath); err == nil {
				return
			}
		}
	}
}
