{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sea:warehouse:favorite:ods:subjectref-v2-r1",
  "title": "Historic favorite ODS SubjectRef v2 sidecar revision 1",
  "description": "Immutable v1 EventSpec plus the approved PostgreSQL issuer/UID projection; not a v2 wire EventSpec.",
  "type": "object",
  "additionalProperties": false,
  "required": ["producer", "source_offset", "event_id", "event_type", "authority_id", "tenant_id", "subject_id", "issuer", "subject_uid", "favorite_id", "folder_id", "target_type", "target_id", "target_revision", "operation", "predecessor_event_id", "event_time", "available_at", "dc_received_at", "source_event_hash", "technical_receipt", "event_spec", "origin_ods_sha256"],
  "properties": {
    "producer": {"const": "rtw.community.favorite"},
    "source_offset": {"type": "integer", "minimum": 1},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["rtw.favorite.assert", "rtw.favorite.retract"]},
    "authority_id": {"const": "rtw.identity"},
    "tenant_id": {"const": "platform"},
    "subject_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "issuer": {"const": "rtw.identity"},
    "subject_uid": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "favorite_id": {"type": "string", "minLength": 1},
    "folder_id": {"type": "string", "minLength": 1},
    "target_type": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "target_revision": {"type": ["string", "null"]},
    "operation": {"enum": ["assert", "retract"]},
    "predecessor_event_id": {"type": "string"},
    "event_time": {"type": "string", "format": "date-time"},
    "available_at": {"type": "string", "format": "date-time"},
    "dc_received_at": {"type": "string", "format": "date-time"},
    "source_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "technical_receipt": {"type": "string", "minLength": 1},
    "event_spec": {"type": "string", "minLength": 1},
    "origin_ods_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
