{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sea:training-dataset-manifest:v2",
  "title": "TrainingDatasetManifest v2",
  "description": "Immutable algorithm dataset handoff. Dataset owner: BTW training; instances: warehouse export.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "sea.training-dataset.v2"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "domain": {
      "enum": [
        "search",
        "recommend"
      ]
    },
    "data_kind": {
      "enum": [
        "synthetic",
        "observed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "feature_contract_id": {
      "type": "string",
      "minLength": 1
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "arrow_type": {
            "enum": [
              "string",
              "float64",
              "uint8",
              "uint32",
              "int64",
              "bool",
              "timestamp[us, tz=UTC]"
            ]
          },
          "nullable": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "arrow_type",
          "nullable"
        ]
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warehouse_run_id": {
          "type": "string",
          "minLength": 1
        },
        "project_revision": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "ingest_cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "batches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "batch_id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "batch_id",
              "sha256"
            ]
          }
        },
        "watermarks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "partition": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "integer",
                "minimum": 0
              },
              "event_time": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "source",
              "partition",
              "position",
              "event_time"
            ]
          }
        },
        "dim_revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "content_revision"
            ],
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "content_revision": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "dbt_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dbt_run_results_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recipe_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "warehouse_run_id",
        "project_revision",
        "generation",
        "ingest_cutoff",
        "batches",
        "watermarks",
        "dim_revisions",
        "dbt_manifest_sha256",
        "dbt_run_results_sha256",
        "recipe_sha256"
      ]
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "maturity_watermark": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "enum": [
            "observed_behavior",
            "human_judgment",
            "teacher",
            "synthetic"
          ]
        },
        "window_anchor": {
          "const": "impression_time"
        }
      },
      "required": [
        "target",
        "rule_version",
        "window_seconds",
        "maturity_watermark",
        "source",
        "window_anchor"
      ]
    },
    "splits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "train",
              "validation",
              "test"
            ]
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "name",
          "start",
          "end"
        ]
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "enum": [
              "train",
              "validation",
              "test"
            ]
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "split",
          "rows",
          "size_bytes",
          "sha256"
        ]
      }
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "transform_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "fit_split": {
            "const": "train"
          }
        },
        "required": [
          "name",
          "path",
          "sha256",
          "fit_split"
        ]
      }
    },
    "row_contract": {
      "enum": [
        "sea.recommend-engagement.v1"
      ]
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "revision",
    "parent_revision",
    "domain",
    "data_kind",
    "created_at",
    "feature_contract_id",
    "columns",
    "source",
    "label",
    "splits",
    "files",
    "row_count",
    "transform_refs",
    "row_contract"
  ]
}
