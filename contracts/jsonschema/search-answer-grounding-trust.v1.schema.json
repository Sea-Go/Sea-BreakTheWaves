{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sea-go.dev/contracts/search-answer-grounding-trust.v1.schema.json",
  "title": "RTW-approved offline grounding reviewer key",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "data_kind", "authority", "reviewer_id", "public_key_ed25519_hex"],
  "properties": {
    "schema_version": {"const": "sea.search.answer-grounding-trust.v1"},
    "data_kind": {"enum": ["human_admin", "synthetic_fixture"]},
    "authority": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "public_key_ed25519_hex": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
