{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sea-go.dev/contracts/search-answer-grounding-case.v1.schema.json",
  "title": "Frozen answer-grounding case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "policy_revision", "review_status", "activation",
    "search_id", "answer_id", "model_interaction_id", "model_response_sha256",
    "rtw_answer_report_sha256", "dc_usage_report_sha256", "rtw_trace_log_sha256",
    "rtw_trace_id", "trace_scope", "citation_pack_ref", "evidence",
    "accepted_answer", "accepted_answer_sha256", "prior_quality_observation"
  ],
  "properties": {
    "schema_version": {"const": "sea.search.answer-grounding-case.v1"},
    "case_id": {"type": "string", "pattern": "^grounding-[a-f0-9]{64}$"},
    "policy_revision": {"const": "sea.search.answer-grounding-human-review.v1"},
    "review_status": {"const": "pending_human_review"},
    "activation": {"const": "none"},
    "search_id": {"type": "string", "minLength": 1},
    "answer_id": {"type": "string", "minLength": 1},
    "model_interaction_id": {"type": "string", "minLength": 1},
    "model_response_sha256": {"$ref": "#/$defs/sha256"},
    "rtw_answer_report_sha256": {"$ref": "#/$defs/sha256"},
    "dc_usage_report_sha256": {"$ref": "#/$defs/sha256"},
    "rtw_trace_log_sha256": {"$ref": "#/$defs/sha256"},
    "rtw_trace_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "trace_scope": {"const": "rtw_structured_log_not_otlp_collector"},
    "citation_pack_ref": {"type": "string", "pattern": "^search-citations/sha256/[a-f0-9]{64}$"},
    "evidence": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "quote", "quote_sha256"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1},
        "quote_sha256": {"$ref": "#/$defs/sha256"}
      }
    }},
    "accepted_answer": {"type": "string", "minLength": 1},
    "accepted_answer_sha256": {"$ref": "#/$defs/sha256"},
    "prior_quality_observation": {"type": "string", "minLength": 1}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
