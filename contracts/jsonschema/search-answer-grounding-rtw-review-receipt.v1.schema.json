{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sea-go.dev/contracts/search-answer-grounding-rtw-review-receipt.v1.schema.json",
  "title": "RTW Worker immutable answer-grounding review receipt data",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_sha256", "case_json", "review_json", "review_sha256",
    "key_id", "reviewer_authority", "reviewer_id", "data_kind", "registry_revision_at_commit",
    "answer_id", "search_id", "accepted_answer_sha256", "turn_sha256", "citation_pack_ref",
    "citation_pack_sha256", "trace_authority_status", "reviewed_at", "event_id", "event_sha256"],
  "properties": {
    "schema_version": {"const": "sea.rtw.answer-grounding-review-receipt.v1"},
    "case_sha256": {"$ref": "#/$defs/sha256"},
    "case_json": {"type": "string", "minLength": 1},
    "review_json": {"type": "string", "minLength": 1},
    "review_sha256": {"$ref": "#/$defs/sha256"},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "reviewer_authority": {"const": "ridethewind.knowledge.admin"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "data_kind": {"enum": ["human_admin", "synthetic_fixture"]},
    "registry_revision_at_commit": {"type": "integer", "minimum": 1},
    "answer_id": {"type": "string", "minLength": 1},
    "search_id": {"type": "string", "minLength": 1},
    "accepted_answer_sha256": {"$ref": "#/$defs/sha256"},
    "turn_sha256": {"$ref": "#/$defs/sha256"},
    "citation_pack_ref": {
      "type": "string",
      "pattern": "^search-citations/sha256/[a-f0-9]{64}$",
      "description": "RTW durable_ref; suffix is SHA-256(search_id bytes), not the pack digest"
    },
    "citation_pack_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of the exact immutable evidence-pack JSON bytes; independent from durable_ref"
    },
    "trace_authority_status": {"const": "external_case_unverified"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "event_id": {"type": "string", "minLength": 1},
    "event_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
