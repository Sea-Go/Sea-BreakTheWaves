{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sea:search-qrel-dataset-manifest:v1",
  "title": "SearchQrelDatasetManifest v1",
  "description": "Immutable pointwise judged search qrels. Training owns schema/reader; warehouse publishes instances.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","row_contract","dataset_id","revision","parent_revision","parent_manifest_sha256",
    "domain","data_kind","created_at","judgment_policy_id","split_policy_id","near_duplicate_scope",
    "columns","source","splits","files","row_count"],
  "properties": {
    "schema_version": {"const":"sea.search-qrel-dataset.v1"},
    "row_contract": {"const":"sea.search-qrel.v1"},
    "dataset_id": {"type":"string","minLength":1},
    "revision": {"type":"integer","minimum":1},
    "parent_revision": {"type":["integer","null"],"minimum":1},
    "parent_manifest_sha256": {"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "domain": {"const":"search"},
    "data_kind": {"enum":["synthetic","observed"]},
    "created_at": {"type":"string","format":"date-time"},
    "judgment_policy_id": {"type":"string","minLength":1},
    "split_policy_id": {"type":"string","minLength":1},
    "near_duplicate_scope": {"const":"query"},
    "columns": {
      "type":"array","minItems":1,
      "items":{"type":"object","additionalProperties":false,
        "required":["name","arrow_type","nullable"],
        "properties":{
          "name":{"type":"string","minLength":1},
          "arrow_type":{"enum":["string","uint8","uint32","bool","timestamp[us, tz=UTC]"]},
          "nullable":{"type":"boolean"}
        }}
    },
    "source": {
      "type":"object","additionalProperties":false,
      "required":["warehouse_run_id","project_revision","generation","ingest_cutoff","batches","watermarks",
        "judgment_snapshot_sha256","content_snapshot_sha256","dbt_manifest_sha256","dbt_run_results_sha256","recipe_sha256"],
      "properties":{
        "warehouse_run_id":{"type":"string","minLength":1},
        "project_revision":{"type":"string","minLength":1},
        "generation":{"type":"string","minLength":1},
        "ingest_cutoff":{"type":"string","format":"date-time"},
        "judgment_snapshot_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "content_snapshot_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "dbt_manifest_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "dbt_run_results_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "recipe_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "batches":{"type":"array","minItems":1,"items":{
          "type":"object","additionalProperties":false,"required":["batch_id","sha256"],
          "properties":{"batch_id":{"type":"string","minLength":1},
                        "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
        "watermarks":{"type":"array","minItems":1,"items":{
          "type":"object","additionalProperties":false,"required":["source","partition","position","event_time"],
          "properties":{"source":{"type":"string","minLength":1},
                        "partition":{"type":"string","minLength":1},
                        "position":{"type":"integer","minimum":0},
                        "event_time":{"type":"string","format":"date-time"}}}}
      }
    },
    "splits": {
      "type":"array","minItems":3,"maxItems":3,
      "items":{"type":"object","additionalProperties":false,
        "required":["name","start","end","rows","shard_count"],
        "properties":{
          "name":{"enum":["train","validation","test"]},
          "start":{"type":"string","format":"date-time"},
          "end":{"type":"string","format":"date-time"},
          "rows":{"type":"integer","minimum":1},
          "shard_count":{"type":"integer","minimum":1}
        }}
    },
    "files": {
      "type":"array","minItems":3,
      "items":{"type":"object","additionalProperties":false,
        "required":["path","split","shard_index","rows","size_bytes","sha256"],
        "properties":{
          "path":{"type":"string","minLength":1},
          "split":{"enum":["train","validation","test"]},
          "shard_index":{"type":"integer","minimum":0},
          "rows":{"type":"integer","minimum":1},
          "size_bytes":{"type":"integer","minimum":1},
          "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
        }}
    },
    "row_count":{"type":"integer","minimum":3}
  }
}
